.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F5;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 210rpx;
  color: #555;
  font-size: 26rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 26rpx;
  text-align: right;
}

.btns {
  justify-content: center;
  margin-bottom: 24rpx;
}

.btns .btn-sm {
  margin: 0 12rpx;
}

.tip {
  display: block;
  margin-top: 16rpx;
  color: #8A9099;
  font-size: 22rpx;
  line-height: 1.6;
}
