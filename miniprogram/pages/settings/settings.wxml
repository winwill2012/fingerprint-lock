<view class="page">

  <view class="card">
    <view class="field">
      <text class="label">MQTT 地址</text>
      <input class="input" value="{{host}}" data-field="host" bindinput="onInput" placeholder="如 broker.emqx.io" />
    </view>
    <view class="field">
      <text class="label">端口</text>
      <input class="input" type="number" value="{{port}}" data-field="port" bindinput="onInput" placeholder="8083(ws) / 8084(wss)" />
    </view>
    <view class="field">
      <text class="label">WebSocket 路径</text>
      <input class="input" value="{{path}}" data-field="path" bindinput="onInput" placeholder="/mqtt" />
    </view>
    <view class="field">
      <text class="label">使用 TLS (wss)</text>
      <switch checked="{{tls}}" bindchange="onTls" color="#1B66E9" />
    </view>
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" value="{{username}}" data-field="username" bindinput="onInput" placeholder="可选" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password value="{{password}}" data-field="password" bindinput="onInput" placeholder="可选" />
    </view>
    <view class="field">
      <text class="label">命令密钥(可选)</text>
      <input class="input" value="{{key}}" data-field="key" bindinput="onInput" placeholder="与固件 MQTT_CMD_KEY 一致" />
    </view>
    <view class="field">
      <text class="label">指令下发 Topic</text>
      <input class="input" value="{{cmdTopic}}" data-field="cmdTopic" bindinput="onInput" placeholder="lock/esp32c3/cmd" />
    </view>
    <view class="field">
      <text class="label">状态反馈 Topic</text>
      <input class="input" value="{{respTopic}}" data-field="respTopic" bindinput="onInput" placeholder="lock/esp32c3/cmd/resp" />
    </view>
  </view>

  <view class="row btns">
    <button class="btn-sm primary" bindtap="onSave">保存配置</button>
    <button class="btn-sm" bindtap="onConnect">连接</button>
    <button class="btn-sm" bindtap="onDisconnect">断开</button>
  </view>

  <view class="card">
    <view class="row">
      <view class="dot {{connected ? 'ok' : 'bad'}}"></view>
      <text>连接状态：{{statusText}}</text>
    </view>
    <text class="tip">提示：真机调试需在小程序后台配置 Socket 合法域名（wss）；开发阶段可在开发者工具勾选"不校验合法域名"。公共 Broker 仅用于测试。</text>
  </view>

</view>
