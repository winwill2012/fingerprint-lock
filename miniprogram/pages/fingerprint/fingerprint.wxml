<view class="page">

  <view class="topbar">
    <button class="btn-sm primary" bindtap="onAdd">＋ 录入指纹</button>
    <button class="btn-sm" bindtap="refresh">刷新</button>
  </view>

  <!-- 录入进度 -->
  <view class="card enroll-panel" wx:if="{{enrolling}}">
    <view class="enroll-dot"></view>
    <text class="enroll-text">{{enrollText}}</text>
    <button class="btn-sm cancel" bindtap="onCancelEnroll">取消录入</button>
  </view>

  <!-- 指纹列表 -->
  <view class="card" wx:for="{{list}}" wx:key="id" wx:for-item="item" style="margin-bottom:16rpx;">
    <view class="row" style="justify-content:space-between;">
      <view>
        <view class="row">
          <text class="fp-id">#{{item.id}}</text>
          <text class="fp-note">{{item.note || '未备注'}}</text>
        </view>
        <text class="sub">{{item.tsText || '录入时间未知'}}</text>
      </view>
      <view class="row">
        <button class="btn-sm" size="mini" data-id="{{item.id}}" bindtap="onRename">备注</button>
        <button class="btn-sm danger" size="mini" data-id="{{item.id}}" bindtap="onDelete">删除</button>
      </view>
    </view>
  </view>

  <view class="card empty" wx:if="{{!list.length && !enrolling}}">
    <text class="sub">暂无指纹记录，点击右上角"录入指纹"</text>
  </view>

  <button class="btn-block danger" bindtap="onClearAll" wx:if="{{list.length}}">清空所有指纹</button>

</view>
