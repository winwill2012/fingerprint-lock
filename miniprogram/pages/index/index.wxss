.state {
  font-weight: 600;
  font-size: 30rpx;
}

.right {
  margin-left: auto;
}

.battery {
  font-size: 28rpx;
  font-weight: 600;
  color: #1B66E9;
}

.unlock-wrap {
  margin: 80rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.unlock-btn {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2E7CF6, #1B66E9);
  color: #FFF;
  font-size: 44rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 30rpx rgba(27, 102, 233, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.unlock-btn.disabled {
  background: #C4C9D2;
  box-shadow: none;
}

.unlock-pressed {
  transform: scale(0.94);
  opacity: 0.9;
}

.hint {
  margin-top: 24rpx;
  color: #8A9099;
  font-size: 24rpx;
}

.refresh {
  background: #F1F3F8;
  color: #333;
}
